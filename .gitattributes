# Normalise line endings in the repository, and keep working copies as-is.
# The site is deployed as plain files, so CRLF creeping in would be noise in
# every diff and could matter to strict servers.
* text=auto eol=lf

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.py   text eol=lf
*.webmanifest text eol=lf

# Never touch binaries
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary